RewriteEngine On
 
# Se for exatamente /admin ou /admin/

RewriteRule ^admin/?$ /admin/index.php [L]
 
# Permitir ficheiros e pastas reais (inclui /admin/index.php)

RewriteCond %{REQUEST_FILENAME} -f [OR]

RewriteCond %{REQUEST_FILENAME} -d

RewriteRule ^ - [L]
 
# Regra geral (front controller)

RewriteRule ^ index.php [QSA,L]
 